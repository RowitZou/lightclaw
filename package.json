{
  "name": "lightclaw",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "bin": {
    "lightclaw": "dist/cli.js"
  },
  "ilink_appid": "bot",
  "scripts": {
    "gen:skills": "tsx scripts/build-bundled-skills.ts",
    "copy:skill-assets": "tsx scripts/copy-skill-assets.ts",
    "predev": "pnpm gen:skills",
    "dev": "tsx src/cli.ts",
    "prebuild": "pnpm gen:skills",
    "build": "tsdown src/cli.ts --format esm --out-dir dist --clean && pnpm copy:skill-assets",
    "start": "node dist/cli.js",
    "pretypecheck": "pnpm gen:skills",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm gen:skills",
    "test": "tsx --test $(find src -name '*.test.ts')"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.63.0",
    "@clack/prompts": "^1.4.0",
    "@larksuiteoapi/node-sdk": "^1.61.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axios": "^1.15.2",
    "chalk": "^5.4.1",
    "https-proxy-agent": "^9.0.0",
    "openai": "^6.34.0",
    "proxy-chain": "^2.7.1",
    "turndown": "^7.2.4",
    "undici": "^8.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "@types/turndown": "^5.0.6",
    "tsdown": "^0.12.9",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.33.0"
}
